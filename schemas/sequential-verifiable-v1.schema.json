{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/marcojpad-hash/orquestador-central/blob/main/schemas/sequential-verifiable-v1.schema.json",
  "title": "SEQUENTIAL-VERIFIABLE-v1 input contract",
  "description": "Input X for explicitly marked sequential, mechanically verifiable work.",
  "type": "object",
  "required": ["$schema", "_contract", "id", "project", "version", "steps", "expected_output"],
  "properties": {
    "$schema": {
      "const": "https://github.com/marcojpad-hash/orquestador-central/blob/main/schemas/sequential-verifiable-v1.schema.json"
    },
    "_contract": {"const": "SEQUENTIAL-VERIFIABLE-v1"},
    "id": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "action", "expected", "verify"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "action": {"type": "string", "minLength": 1},
          "expected": {"type": "string", "minLength": 1},
          "verify": {"type": "string", "minLength": 1},
          "retry_safe": {"type": "boolean", "default": false}
        },
        "additionalProperties": false
      }
    },
    "expected_output": {
      "type": "object",
      "required": ["type", "path", "min_count", "min_length"],
      "properties": {
        "type": {"enum": ["file", "files", "text"]},
        "path": {"type": "string", "minLength": 1},
        "min_count": {"type": "integer", "minimum": 1},
        "min_length": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}